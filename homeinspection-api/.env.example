# Copy to ".env" in this directory (homeinspection-api/) before running the API.
# Values below are placeholders only — never commit real secrets.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# NODE_ENV is optional; defaults to "development" when unset.
NODE_ENV=development

# PORT is optional; defaults to 3000 when unset.
PORT=3000

# -----------------------------------------------------------------------------
# Authentication (Story 1.6) — validated at boot in Story 1.2
# -----------------------------------------------------------------------------
# AUTH_MODE is required: "mock" for local/CI prototype, "live" for API-key auth.
AUTH_MODE=mock

# When AUTH_MODE=mock: header name and value clients must send (prototype only).
MOCK_AUTH_HEADER_NAME=x-mock-auth
MOCK_AUTH_HEADER_VALUE=change-me-local-only

# When AUTH_MODE=live: comma-separated API keys (no spaces around commas recommended).
# Example (fake keys): LIVE_KEY_aaa,LIVE_KEY_bbb
API_KEYS=

# -----------------------------------------------------------------------------
# Rate limiting — upload route (Story 1.7), optional with defaults
# -----------------------------------------------------------------------------
# Rolling/fixed window length in minutes (default 60).
RATE_LIMIT_WINDOW_MINUTES=60

# Max requests allowed in that window for the governed route (default 100).
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# LLM sidecar (Epic 5) — validated at boot (Story 5.2+); defaults match docker-compose
# -----------------------------------------------------------------------------
# Ollama HTTP API base (loopback when using homeinspection-api/docker-compose.yml).
# May include a path prefix (e.g. http://127.0.0.1:11434/ollama) when behind a reverse proxy or
# sub-path mount; the adapter appends /api/chat relative to that base (must be http(s), no userinfo).
LLM_BASE_URL=http://127.0.0.1:11434

# Model id as understood by Ollama (pull the same tag, e.g. ollama pull llama3.2:1b).
LLM_MODEL=llama3.2:1b

# Client-side HTTP timeout for /api/chat (milliseconds).
LLM_TIMEOUT_MS=300000

# Optional Bearer token for secured or OpenAI-compatible gateways (usually empty locally).
LLM_API_KEY=

# Optional; default false. When true/1/yes/on: log truncated Ollama /api/chat metadata (redacted Bearer,
# truncated system/user messages, truncated response and assistant text). Invalid tokens fail at startup.
LLM_DEBUG_LOG=false
