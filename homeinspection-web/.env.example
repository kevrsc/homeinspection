# Copy to ".env" in this directory (homeinspection-web/). Values must align with homeinspection-api/.env when testing locally.

# -----------------------------------------------------------------------------
# API origin (browser fetch target)
# -----------------------------------------------------------------------------
# Leave empty in local dev to use same-origin "/v1/..." requests — Vite proxies "/v1" to the API (see vite.config.ts).
# For production builds against a separate API host, set the origin only (no trailing slash required), e.g.:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Auth — mirror homeinspection-api AUTH_MODE
# -----------------------------------------------------------------------------
# mock: send prototype header (must match API MOCK_AUTH_HEADER_NAME / MOCK_AUTH_HEADER_VALUE).
# live: send Authorization: Bearer <VITE_API_KEY> (API also accepts x-api-key; this client uses Bearer only).
VITE_AUTH_MODE=mock

VITE_MOCK_AUTH_HEADER_NAME=x-mock-auth
VITE_MOCK_AUTH_HEADER_VALUE=change-me-local-only

# Required when VITE_AUTH_MODE=live — comma-separated keys are NOT supported here; use one key that exists in API API_KEYS.
VITE_API_KEY=

# -----------------------------------------------------------------------------
# Dev proxy target (read by vite.config.ts only; not required at runtime in the bundle)
# -----------------------------------------------------------------------------
VITE_PROXY_TARGET=http://localhost:3000
